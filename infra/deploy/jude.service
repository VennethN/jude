[Unit]
Description=Jude application and TLS proxy
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/jude/host.env
RuntimeDirectory=jude
RuntimeDirectoryMode=0700
ExecStart=/usr/local/sbin/jude-release
ExecStop=-/usr/bin/docker stop --time 20 jude-proxy jude-app
Restart=on-failure
RestartSec=30
TimeoutStartSec=15min
TimeoutStopSec=1min

[Install]
WantedBy=multi-user.target
