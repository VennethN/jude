project                = "jude"
environment            = "dev"
db_engine_version      = "latest"
db_instance_class      = "db.t4g.micro"
db_multi_az            = false
db_backup_days         = 7
db_deletion_protection = true

# Use your own public IP /32 here to restrict access later.
db_publicly_accessible  = true
db_allowed_public_cidrs = ["0.0.0.0/0"]
