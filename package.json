{
  "name": "jude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/start.mjs --dev",
    "build": "pnpm --filter @jude/web build",
    "start": "node scripts/start.mjs",
    "check": "pnpm --filter @jude/web check",
    "test": "vitest run --config packages/core/vitest.config.ts",
    "test:e2e": "playwright test --config apps/web/playwright.config.ts",
    "design:check": "pnpm --filter @jude/web design:check",
    "design:install": "impeccable install --providers=codex --scope=project --yes",
    "test:voice": "node scripts/voice.mjs test",
    "voice:start": "node scripts/voice.mjs"
  },
  "dependencies": {
    "@jude/core": "workspace:*",
    "@jude/web": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "impeccable": "4.8.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ]
}
