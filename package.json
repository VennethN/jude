{
  "name": "jude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @jude/web dev",
    "build": "pnpm --filter @jude/web build && pnpm --filter @jude/voice build",
    "start": "node apps/voice/dist/server.mjs",
    "check": "pnpm --filter @jude/web check && pnpm --filter @jude/voice check",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@jude/core": "workspace:*",
    "@jude/voice": "workspace:*",
    "@jude/web": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
