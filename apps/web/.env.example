# Server environment. Leave provider settings empty for a local synthetic case.
ORIGIN=http://localhost:5173
DATABASE_URL=
JUDE_DB_PATH=
JUDE_FILES_DIR=
AWS_REGION=ap-southeast-3
JUDE_S3_BUCKET=
JUDE_S3_KMS_KEY=
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_MODEL=gpt-6.1-sol
# Optional per-task overrides; otherwise OPENAI_MODEL is used.
OPENAI_ASSISTANT_MODEL=
OPENAI_ANALYSIS_MODEL=
OPENAI_REVIEW_MODEL=
# Shared embedding model: PostgreSQL index (1536 dimensions), SQLite assistant cache (512).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Set false to disable external evidence indexing and query embeddings.
JUDE_SEMANTIC_SEARCH=true
# Includes reasoning tokens. Allowed range: 512–16000; default: 6000.
OPENAI_ASSISTANT_MAX_OUTPUT_TOKENS=6000
# Optional server-side access token for Pasal.id Discovery.
JUDE_PASAL_TOKEN=
# For independently hosted services, point web at the internal voice origin.
# An HTTPS Jude voice gateway can share the local app’s database and session.
VOICE_ORIGIN=
# Development only: use a hosted HTTPS voice gateway instead of launching Python.
JUDE_VOICE_REMOTE=false
# Local Python voice recognition; set the absolute WeSpeaker checkpoint path.
JUDE_VOICEPRINT_MODEL=
JUDE_MAIL_FROM=
BODY_SIZE_LIMIT=64M
