# Server environment. Leave provider settings empty for a local synthetic case.
ORIGIN=http://localhost:5173
DATABASE_URL=
JUDE_DB_PATH=
JUDE_FILES_DIR=
AWS_REGION=ap-southeast-3
JUDE_S3_BUCKET=
JUDE_S3_KMS_KEY=
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_MODEL=gpt-6.1-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Set false to disable external evidence indexing and query embeddings.
JUDE_SEMANTIC_SEARCH=true
# Optional server-side access token for Pasal.id Discovery.
JUDE_PASAL_TOKEN=
# For independently hosted services, point web at the internal voice origin.
VOICE_ORIGIN=
JUDE_MAIL_FROM=
BODY_SIZE_LIMIT=64M
