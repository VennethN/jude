# Python voice service. Configure shared database/storage to match web.
DATABASE_URL=
JUDE_DB_PATH=
JUDE_FILES_DIR=
AWS_REGION=ap-southeast-3
JUDE_S3_BUCKET=
JUDE_S3_KMS_KEY=
ORIGIN=http://localhost:5173
VOICE_HOST=127.0.0.1
VOICE_PORT=3001
# Amazon Transcribe streaming is in Singapore; storage stays in Jakarta.
# Use the EC2 instance role in production or an AWS CLI profile locally.
JUDE_TRANSCRIBE_REGION=ap-southeast-1
# Absolute path to the pinned WeSpeaker checkpoint for case voice recognition.
# Included and enabled in the voice-pyannote and release-pyannote images.
JUDE_VOICEPRINT_MODEL=
JUDE_DIARIZATION_MODEL=
JUDE_DIARIZATION_DEVICE=cpu
HF_TOKEN=
